@namespace Blazor.WinOld.Components

@inherits WinOldComponentBase
@implements IAsyncDisposable

<nav @ref="_rootRef"
     class="navpane-win @GetComponentClass() @Class"
     style="@GetStyle()"
     aria-label="@Title"
     @attributes="Attributes">
    <CascadingValue Name="Disabled" Value="@(ParentDisabled == true || Disabled)">
        <CascadingValue Name="TouchMode" Value="@IsTouch">
            <CascadingValue Value="this" IsFixed="false">
                @if (IsToggleVisible || !string.IsNullOrEmpty(Title))
                {
                    <div class="navpane-header">
                        @if (IsToggleVisible)
                        {
                            <button type="button"
                                    class="navpane-toggle"
                                    title="@(Collapsed ? "Expand" : "Collapse")"
                                    aria-expanded="@(Collapsed ? "false" : "true")"
                                    disabled="@(ParentDisabled == true || Disabled)"
                                    @onclick="ToggleCollapsed">
                                @switch (EffectiveAppearance)
                                {
                                    case global::Blazor.WinOld.Components.Appearance.DOS:
                                        @* CP437 0x1A / 0x1B *@
                                        <span class="navpane-toggle-dos-arrow" aria-hidden="true">@(Collapsed ? "→" : "←")</span>
                                        break;
                                    case global::Blazor.WinOld.Components.Appearance.Win31:
                                    case global::Blazor.WinOld.Components.Appearance.Win98:
                                        <svg class="navpane-toggle-arrow" width="8" height="8" viewBox="0 0 8 8" aria-hidden="true">
                                            <path d="M6 0v8L2 4z" fill="currentColor" />
                                        </svg>
                                        break;
                                    case global::Blazor.WinOld.Components.Appearance.WinXP:
                                    case global::Blazor.WinOld.Components.Appearance.Win7:
                                        <svg class="navpane-toggle-arrow" width="10" height="10" viewBox="0 0 10 10" aria-hidden="true">
                                            <path d="M6.5 1.5L3 5l3.5 3.5" stroke="currentColor" stroke-width="1.5" fill="none" />
                                        </svg>
                                        break;
                                    default:
                                        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
                                            <path d="M1 3.5h14M1 8h14M1 12.5h14" stroke="currentColor" stroke-width="1.2" fill="none" />
                                        </svg>
                                        break;
                                }
                            </button>
                        }
                        @if (!string.IsNullOrEmpty(Title))
                        {
                            <span class="navpane-title">@Title</span>
                        }
                    </div>
                }
                @if (HeaderContent is not null && !Collapsed)
                {
                    <div class="navpane-header-content">@HeaderContent</div>
                }
                <div class="navpane-body @EffectiveAppearance.ToScrollbarClass()">
                    @ChildContent
                </div>
                @if (FooterContent is not null)
                {
                    <div class="navpane-footer">@FooterContent</div>
                }
            </CascadingValue>
        </CascadingValue>
    </CascadingValue>
</nav>
