@namespace Blazor.WinOld.Components

@inherits WinOldComponentBase

@switch (GetLevel())
{
	case 1:
		<h1 class="@GetComponentClass()" style="@Style" disabled="@IsDisabled" @attributes="Attributes">@ChildContent</h1>
		break;
	case 3:
		<h3 class="@GetComponentClass()" style="@Style" disabled="@IsDisabled" @attributes="Attributes">@ChildContent</h3>
		break;
	case 4:
		<h4 class="@GetComponentClass()" style="@Style" disabled="@IsDisabled" @attributes="Attributes">@ChildContent</h4>
		break;
	case 5:
		<h5 class="@GetComponentClass()" style="@Style" disabled="@IsDisabled" @attributes="Attributes">@ChildContent</h5>
		break;
	case 6:
		<h6 class="@GetComponentClass()" style="@Style" disabled="@IsDisabled" @attributes="Attributes">@ChildContent</h6>
		break;
	default:
		<h2 class="@GetComponentClass()" style="@Style" disabled="@IsDisabled" @attributes="Attributes">@ChildContent</h2>
		break;
}
