@namespace Blazor.WinOld.Components

@inherits WinOldComponentBase

@if (IsVisible)
{
    <div class="msg-win-backdrop" style="z-index: @_zIndex">
        <div @ref="_windowRef"
             role="alertdialog"
             aria-modal="true"
             aria-labelledby="@_titleId"
             class="@GetMessageBoxClass()"
             style="@TitleBarColorStyle.ForWindow(Options.Appearance, Options.TitleBarColor)">
            <WinOldTitleBar @ref="_titleBar"
                            BarClass="@GetTitleBarClass()"
                            TextClass="@GetTitleBarTextClass()"
                            ControlsClass="@GetTitleBarControlsClass()"
                            Style="@TitleBarColorStyle.ForTitleBar(Options.Appearance, Options.TitleBarColor)"
                            Title="@Options.Title"
                            TitleId="@_titleId"
                            TouchMode="@(IsTouch || Options.TouchMode)"
                            OnClose="HandleCancel" />
            <div class="message-body @GetMessageBodyClass()">
				@if (Options.Icon != Icon.None && Options.Appearance != Appearance.DOS)
				{
                    <WinOldIcon Icon="Options.Icon" Appearance="Options.Appearance" />
				}
                <div class="@GetMessageContentClass()">@Options.Message</div>
            </div>
            <div class="actions">
                <WinOldButton OnClick="HandleOk"
                              DosColor="GetDosButtonColor()"
                              Appearance="Options.Appearance">@Options.OkButtonText</WinOldButton>
                @if (!string.IsNullOrEmpty(Options.CancelButtonText))
                {
                    <WinOldButton OnClick="HandleCancel"
                                  DosColor="GetDosButtonColor()"
                                  Appearance="Options.Appearance"
                                  Style="margin-left: 8px;">@Options.CancelButtonText</WinOldButton>
                }
            </div>
        </div>
    </div>
}

<DraggableWindow @ref="_draggable" />
