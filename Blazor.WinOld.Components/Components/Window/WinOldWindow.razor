@namespace Blazor.WinOld.Components

@inherits WinOldComponentBase
@implements IAsyncDisposable

<div @ref="_windowRef" class="win-window @GetWindowClass() @GetDosColorClass() @GetMaximizedClass() @GetInactiveClass() @Class" style="@Style" @attributes="Attributes">
    <WinOldTitleBar @ref="_titleBar"
                    BarClass="@($"win-title-bar {GetTitleBarClass()}")"
                    Active="Active"
                    TextClass="@GetTitleTextClass()"
                    ControlsClass="@GetTitleControlsClass()"
                    Title="@Title"
                    ShowCloseButton="ShowCloseButton"
                    OnClose="OnClose"
                    ShowMaximizeButton="MaxButton"
                    OnToggleMaximize="ToggleMaximize" />
    <div class="win-body @GetBodyClass()">
        <CascadingValue Name="WindowAppearance" Value="@((Appearance?)Appearance)">
            <CascadingValue Name="Disabled" Value="@Disabled">
                @ChildContent
            </CascadingValue>
        </CascadingValue>
    </div>
    @if (StatusBar is not null)
    {
        <div class="win-statusbar @GetStatusBarSlotClass()">
            <CascadingValue Name="WindowAppearance" Value="@((Appearance?)Appearance)">
                <CascadingValue Name="Disabled" Value="@Disabled">
                    @StatusBar
                </CascadingValue>
            </CascadingValue>
        </div>
    }
</div>

<DraggableWindow @ref="_draggable" />
