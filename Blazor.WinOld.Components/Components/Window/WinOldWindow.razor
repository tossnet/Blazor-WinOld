@namespace Blazor.WinOld.Components

@inherits WinOldComponentBase

<div class="win-window @GetWindowClass() @GetMaximizedClass() @Class" style="@Style" @attributes="Attributes">
    <WinOldTitleBar BarClass="@($"win-title-bar {GetTitleBarClass()}")"
                    TextClass="@GetTitleTextClass()"
                    ControlsClass="@GetTitleControlsClass()"
                    Title="@Title"
                    ShowCloseButton="ShowCloseButton"
                    OnClose="OnClose"
                    ShowMaximizeButton="MaxButton"
                    OnToggleMaximize="ToggleMaximize" />
    <div class="win-body @GetBodyClass()">
        <CascadingValue Name="Disabled" Value="@Disabled">
            @ChildContent
        </CascadingValue>
    </div>
</div>
