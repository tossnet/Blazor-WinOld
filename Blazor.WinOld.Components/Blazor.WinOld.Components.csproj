<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFrameworks>net9.0;net10.0</TargetFrameworks>

		<RootNamespace>BlazorWinOld</RootNamespace>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Package metadata -->
		<PackageId>BlazorWinOld</PackageId>
		<Version>3.1.0</Version>
		<Authors>Christophe Peugnet</Authors>
		<Copyright>Copyright 2025-2026</Copyright>
		<Description>Blazor components in DOS, Windows 3.11, Windows 98, Windows XP, Windows 7 and Windows 10 desktop styles. For use with .NET 9.0 or higher Blazor applications</Description>
		<PackageTags>blazor;components;dos;win31;win98;winXP;win7;win10;windows-xp;windows-3;windows-98;windows-7;windows-10</PackageTags>
		<PackageProjectUrl>https://github.com/tossnet/Blazor-WinOld</PackageProjectUrl>
		<RepositoryUrl>https://github.com/tossnet/Blazor-WinOld.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>icon.png</PackageIcon>
		<PackageReleaseNotes>v3.1.0 Full changelog: https://github.com/tossnet/Blazor-WinOld/blob/master/CHANGELOG.md</PackageReleaseNotes>

		<!-- Build and symbols -->
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<DebugType>portable</DebugType>

		<!-- Trimming -->
		<IsTrimmable>true</IsTrimmable>
	</PropertyGroup>

	<ItemGroup>
		<None Include="icon.png" Pack="true" PackagePath="\" />
		<None Include="..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<SupportedPlatform Include="browser" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="9.0.20" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.12" />
	</ItemGroup>

	<ItemGroup>
	  <Content Update="wwwroot\js\draggable.js">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </Content>
	  <Content Update="wwwroot\js\textbox.js">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </Content>
	</ItemGroup>

	<!-- Generates static/dist/winold.css (CSS for non-Blazor / static sites) on each build -->
	<Import Project="StaticDist.targets" />

</Project>
