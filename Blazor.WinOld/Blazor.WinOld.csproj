<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Brism" Version="1.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="9.0.20" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="9.0.20" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
		<!-- Force l'utilisation de la version net9.0 de la library -->
		<ProjectReference Include="..\Blazor.WinOld.Components\Blazor.WinOld.Components.csproj" SetTargetFramework="TargetFramework=net9.0" />
  </ItemGroup>

  <!--
		Static (non-Blazor) CSS kit generated by the library build (..\static\dist) is copied to
		wwwroot\static\dist (git-ignored) so that wwwroot\static\index.html can use it.
		Runs after the library is built, before the static web assets are discovered.
  -->
  <Target Name="CopyWinOldStaticDist" BeforeTargets="ResolveProjectStaticWebAssets" DependsOnTargets="ResolveProjectReferences">
		<ItemGroup>
			<_WinOldStaticDist Include="..\static\dist\**" />
		</ItemGroup>
		<Copy SourceFiles="@(_WinOldStaticDist)"
			  DestinationFiles="@(_WinOldStaticDist->'wwwroot\static\dist\%(RecursiveDir)%(Filename)%(Extension)')"
			  SkipUnchangedFiles="true" />
		<ItemGroup>
			<Content Remove="wwwroot\static\dist\**" />
			<Content Include="wwwroot\static\dist\**" />
		</ItemGroup>
  </Target>

  </Project>
