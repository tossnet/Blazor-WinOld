</div>

<CodeBlock Language="CodeLanguage.Razor"
		   EnableLineNumbers="true"
		   Code=@(@"
<WinOldHeading Appearance=""Appearance.WinXP"" Level=""1"">Control Panel</WinOldHeading>
<WinOldHeading Appearance=""Appearance.WinXP"">Pick a category</WinOldHeading>") />

<h2>Disabled &amp; custom style</h2>

<div class="wo-row wo-wrap wo-gap-20" style="margin-bottom:10px;">
	<WinOldHeading Appearance="Appearance.Win98" Disabled>Disabled Win98</WinOldHeading>
	<WinOldHeading Appearance="Appearance.Win10" Style="color:#0078d7;">Accent Win10</WinOldHeading>
</div>

<CodeBlock Language="CodeLanguage.Razor"
		   EnableLineNumbers="true"
		   Code=@(@"
<WinOldHeading Appearance=""Appearance.Win98"" Disabled>Disabled Win98</WinOldHeading>
<WinOldHeading Appearance=""Appearance.Win10"" Style=""color:#0078d7;"">Accent Win10</WinOldHeading>") />
