@page "/msgboxpage"

@inject IDialogService DialogService

<PageTitle>MessageBox</PageTitle>

<h1>MessageBox</h1>

<div class="info-block" style="margin-bottom:20px">
	<p>
		⚠️ To enable this component, you need to add the <code>&lt;WinOldMessageBoxHost /&gt;</code> component
		at the bottom of your <strong>MainLayout.razor</strong>:
	</p>
	<CodeBlock Language="CodeLanguage.Razor"
			   EnableLineNumbers="false"
			   Code=@(@"<WinOldMessageBoxHost />") />
</div>

<WinOldFrame Appearance="appearance"
			 Label="Icon"
			 Style="margin-bottom: 20px;">
	<WinOldOptionButtonGroup T="Icon"
							 @bind-Value="icon"
							 Appearance="appearance">
		<WinOldOptionButton Label="None" Value="Icon.None" />
		<WinOldOptionButton Label="Information" Value="Icon.Information" />
		<WinOldOptionButton Label="Question" Value="Icon.Question" />
		<WinOldOptionButton Label="Alert" Value="Icon.Alert" />
		<WinOldOptionButton Label="Critical" Value="Icon.Critical" />
	</WinOldOptionButtonGroup>
</WinOldFrame>

<div style="display:flex; flex-direction: row; gap: 10px; flex-wrap: wrap;">
	<WinOldButton OnClick="() => ClickMe(Appearance.DOS)"
				  Appearance="Appearance.DOS">Show MessageBox DOS</WinOldButton>

	<WinOldButton OnClick="() => ClickMe(Appearance.Win98)"
				  Appearance="Appearance.Win98">Show MessageBox 98</WinOldButton>

	<WinOldButton OnClick="() => ClickMe(Appearance.WinXP)"
				  Appearance="Appearance.WinXP">Show MessageBox XP</WinOldButton>

	<WinOldButton OnClick="() => ClickMe(Appearance.Win7)"
				  Appearance="Appearance.Win7">Show MessageBox 7</WinOldButton>

	<WinOldButton OnClick="() => ClickMe(Appearance.Win10)"
				  Appearance="Appearance.Win10">Show MessageBox 10</WinOldButton>
</div>




<CodeBlock Language="CodeLanguage.Razor"
		   EnableLineNumbers="true"
		   Code=@(@"
@inject IDialogService DialogService

	<WinOldButton OnClick=""ClickMe""
	              Appearance=""Appearance.WinXP"">
	  Show MessageBox
	</WinOldButton>
		   	 ") />

<CodeBlock Language="CodeLanguage.CSharp"
		   EnableLineNumbers="true"  
		   Code=@(@"
   
	private async Task ClickMe()
	{
		var options = new MessageBoxOptions
		{
			Appearance = Appearance.WinXP,
			Title = ""Warning"",
			Message = ""Blazor is awesome!"",
			Icon = Icon.Information,
			OkButtonText = ""OK"",
			CancelButtonText = """"
		};
		var DialogResult = await DialogService.ShowMessageBox(options);
	}
")/>


@code {
	Appearance appearance { get; set; } = Appearance.Win7;
	Icon icon { get; set; } = Icon.Information;

	async Task ClickMe(Appearance appearance)
	{
		var options = new MessageBoxOptions
		{
			Appearance = appearance,
			Title = "Warning",
			Message = "Blazor is \nawesome!",
			Icon = icon,
			OkButtonText = "OK",
			CancelButtonText = ""
		};
		var DialogResult = await DialogService.ShowMessageBox(options);
	}
}
