@page "/tg"
@namespace Blazor.WinOld.Pages.Tg
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Turbo GERARD</PageTitle>

@* Full-screen Turbo Vision style demo, drawn over the site layout. Not listed in the menu. *@
<div class="tg-screen tg-@_appearance.ToString().ToLowerInvariant()" tabindex="0" @ref="_screen"
     @onkeydown="OnKeyDown">
    <WinOldAppShell Appearance="_appearance" IncludeHosts="false" Height="100%">
        <Menu>
            <WinOldMenu>
                <WinOldMenuItem Label="File" HotKey="F">
                    <WinOldMenuItem Label="New" HotKey="N" Shortcut="F4" OnClick="New" />
                    <WinOldMenuItem IsSeparator />
                    <WinOldMenuItem Label="Quit" HotKey="Q" Shortcut="Alt-Q" OnClick="Quit" />
                </WinOldMenuItem>
                <WinOldMenuItem Label="Compile" HotKey="C">
                    <WinOldMenuItem Label="Compile" HotKey="C" Shortcut="F9" OnClick="Compile" />
                    <WinOldMenuItem Label="Run" HotKey="R" Shortcut="Ctrl-F9" OnClick="Run" />
                </WinOldMenuItem>
                <WinOldMenuItem Label="View" HotKey="V">
                    @foreach (var style in Styles)
                    {
                        <WinOldMenuItem Label="@style.Name" OnClick="@(() => SetAppearance(style.Appearance))" />
                    }
                </WinOldMenuItem>
                <WinOldMenuItem Label="Window" HotKey="W">
                    <WinOldMenuItem Label="Next" HotKey="N" Shortcut="F6" OnClick="Next" />
                    <WinOldMenuItem Label="Zoom" HotKey="Z" Shortcut="F5" OnClick="Zoom" />
                </WinOldMenuItem>
                <WinOldMenuItem Label="Help" HotKey="H">
                    <WinOldMenuItem Label="WinOld" HotKey="W" OnClick="OpenSite" />
                    <WinOldMenuItem Label="About" HotKey="A" OnClick="ShowAbout" />
                </WinOldMenuItem>
            </WinOldMenu>
        </Menu>

        <StatusBar>
            <WinOldStatusBar>
                <WinOldStatusBarPanel>
                    <span class="tg-hint"><span class="tg-key">F9</span> Compile</span>
                    <span class="tg-hint"><span class="tg-key">Ctrl-F9</span> Run</span>
                    <span class="tg-hint"><span class="tg-key">F4</span> New</span>
                    <span class="tg-hint"><span class="tg-key">Alt-Q</span> Quit</span>
                </WinOldStatusBarPanel>
            </WinOldStatusBar>
        </StatusBar>

        <ChildContent>
            <div class="tg-desktop">
                @* Rendered in creation order (the DOM never moves, so a drag isn't interrupted): stacking is only z-index. *@
                @foreach (var w in _windows)
                {
                    <WinOldWindow @key="w"
                                  Appearance="_appearance"
                                  DosColor="DosColor.Blue"
                                  Title="@($"TURBO GERARD {w.Number}")"
                                  Active="@(w == Active)"
                                  ShowCloseButton="true"
                                  MaxButton="true"
                                  Draggable="true"
                                  OnMoved="e => Move(w, e)"
                                  @bind-WindowState="w.State"
                                  OnClose="() => Close(w)"
                                  @onpointerdown="() => Activate(w)"
                                  Style="@GetWindowStyle(w)">
                        <div class="tg-editor">
                            <WinOldTextArea Appearance="_appearance"
                                            Value="@w.Source"
                                            ValueChanged="v => w.Source = v"
                                            Rows="8"
                                            InputStyle="@_editorStyle" />
                            @if (w.Output.Count > 0)
                            {
                                <pre class="tg-output">@string.Join("\n", w.Output)</pre>
                            }
                        </div>
                    </WinOldWindow>
                }

                @if (_about)
                {
                    <WinOldWindow Appearance="_appearance"
                                  DosColor="DosColor.Default"
                                  Title="About"
                                  Active="true"
                                  ShowCloseButton="true"
                                  Draggable="true"
                                  OnClose="CloseAbout"
                                  Style="@_aboutStyle">
                        <div class="tg-about">
                            <p>Turbo Gerard 2.0</p>
                            <WinOldButton Appearance="_appearance"
                                          DosColor="DosColor.Green"
                                          OnClick="CloseAbout">OK</WinOldButton>
                        </div>
                    </WinOldWindow>
                }

                @if (_console is { } console)
                {
                    <WinOldWindow @key="console"
                                  Appearance="_appearance"
                                  DosColor="DosColor.Blue"
                                  Title="@console.Title"
                                  Active="true"
                                  ShowCloseButton="true"
                                  Draggable="true"
                                  OnClose="CloseConsole"
                                  Style="@_consoleStyle">
                        <pre class="tg-console">@string.Join("\n", console.Lines)</pre>
                    </WinOldWindow>
                }
            </div>
        </ChildContent>
    </WinOldAppShell>
</div>

@code {
    private sealed class TgWindow
    {
        public int Number { get; init; }
        public double Left { get; set; }
        public double Top { get; set; }
        public WindowState State { get; set; }
        public int ZOrder { get; set; }
        public string Source { get; set; } = "writeln('Turbo Gerard, bail out when it gets hard');";
        public List<string> Output { get; } = new();
    }

    private sealed record TgConsole(string Title, IReadOnlyList<string> Lines);

    private const string SiteUrl = "https://tossnet.github.io/Blazor-WinOld/";

    private readonly List<TgWindow> _windows = new();
    private TgConsole? _console;
    private bool _about;
    private int _count;
    private int _zOrder;
    private ElementReference _screen;
    private bool _refocus = true;
    private Appearance _appearance = Appearance.DOS;
    private IJSObjectReference? _module;

    private const string _consoleStyle =
        "left: 50%; top: 50%; transform: translate(-50%, -50%); z-index: 100000; --dos-box-close: #55ff55;";

    private const string _aboutStyle =
        "left: 50%; top: 50%; transform: translate(-50%, -50%); z-index: 100001; width: 360px; --dos-box-close: #55ff55;";

    private static readonly (Appearance Appearance, string Name)[] Styles =
    {
        (Appearance.DOS, "DOS"),
        (Appearance.Win31, "Win31"),
        (Appearance.Win98, "Win98"),
        (Appearance.WinXP, "WinXP"),
        (Appearance.Win7, "Win7"),
        (Appearance.Win10, "Win10")
    };

    // The active window is the one on top of the others.
    private TgWindow? Active => _windows.MaxBy(w => w.ZOrder);

    // In DOS, the editor takes the same blue (#0000aa) as the dialog boxes.
    private string _editorStyle => _appearance == Appearance.DOS
        ? "width: 100%; font-family: monospace; background: #0000aa; color: #ffffff;"
        : "width: 100%; font-family: monospace;";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./Pages/Tg/Tg.razor.js");
            await _module.InvokeVoidAsync("initKeys", _screen);
        }

        // Keeps the keyboard shortcuts working after a menu click or a closed window.
        if (_refocus)
        {
            _refocus = false;
            await _screen.FocusAsync(preventScroll: true);
        }
    }

    private void New()
    {
        var k = _count++ % 10;
        _windows.Add(new TgWindow { Number = _count, Left = 40 + k * 24, Top = 24 + k * 24, ZOrder = ++_zOrder });
        _refocus = true;
    }

    private void Activate(TgWindow w)
    {
        if (w != Active)
            w.ZOrder = ++_zOrder;
    }

    // Brings the bottom window to the top.
    private void Next()
    {
        if (_windows.MinBy(w => w.ZOrder) is { } bottom)
            Activate(bottom);
        _refocus = true;
    }

    private void Zoom()
    {
        if (Active is { } w)
            w.State = w.State == WindowState.Maximized ? WindowState.Normal : WindowState.Maximized;
        _refocus = true;
    }

    // Keeps the dragged position, otherwise the next render of the style would put the window back.
    private void Move(TgWindow w, WindowMovedEventArgs e)
    {
        w.Left = e.Left;
        w.Top = e.Top;
    }

    private void Close(TgWindow w)
    {
        _windows.Remove(w);
        _refocus = true;
    }

    private void SetAppearance(Appearance appearance)
    {
        _appearance = appearance;
        _refocus = true;
    }

    private void Quit() => Navigation.NavigateTo("");

    private void ShowAbout()
    {
        _about = true;
        _refocus = true;
    }

    private void CloseAbout()
    {
        _about = false;
        _refocus = true;
    }

    // The OK button of the About box goes to the project site.
    private void OpenSite() => Navigation.NavigateTo(SiteUrl, forceLoad: true);

    // Compiles the active window: shows the fake compiler output, then builds the .exe and
    // downloads a zip with the program and its source.
    private async Task Compile()
    {
        if (Active is not { } w) return;

        var result = TgCompiler.Compile(w.Source);
        var count = result.Lines.Count + result.Errors.Count;

        w.Output.Clear();
        w.Output.Add($"Compiling... {count} line{(count > 1 ? "s" : "")}");
        StateHasChanged();
        await Task.Delay(400);

        if (!result.Success)
        {
            w.Output.AddRange(result.Errors);
            _refocus = true;
            return;
        }

        var exe = TgExeBuilder.Build(result.Lines);
        var zip = TgPackager.Zip($"TG{w.Number}", exe, w.Source);
        w.Output.Add($"TG{w.Number}.EXE created ({exe.Length} bytes)");
        w.Output.Add($"TG{w.Number}.zip ready to download.");

        if (_module is not null)
        {
            using var stream = new DotNetStreamReference(new MemoryStream(zip));
            await _module.InvokeVoidAsync("downloadFile", $"TG{w.Number}.zip", stream);
        }

        _refocus = true;
    }

    // Runs the active window's program in a fake console, directly in the page (no Windows needed).
    private Task Run()
    {
        if (Active is not { } w) return Task.CompletedTask;

        var result = TgCompiler.Compile(w.Source);
        if (!result.Success)
        {
            w.Output.Clear();
            w.Output.Add("Compilation error:");
            w.Output.AddRange(result.Errors);
            _refocus = true;
            return Task.CompletedTask;
        }

        var lines = new List<string> { $@"C:\TG>TG{w.Number}" };
        lines.AddRange(result.Lines);
        lines.Add("");
        lines.Add("Press any key...");
        _console = new TgConsole($@"C:\TG\TG{w.Number}.EXE", lines);
        return Task.CompletedTask;
    }

    private void CloseConsole()
    {
        _console = null;
        _refocus = true;
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        // The About box is modal: Escape closes it, other keys do nothing.
        if (_about)
        {
            if (e.Key == "Escape")
                CloseAbout();
            return;
        }

        // Any key closes the fake console, like a real "press a key" prompt.
        if (_console is not null)
        {
            CloseConsole();
            return;
        }

        switch (e.Key)
        {
            case "F9" when e.CtrlKey: await Run(); break;
            case "F9": await Compile(); break;
            case "F4": New(); break;
            case "F5": Zoom(); break;
            case "F6": Next(); break;
            case "F3" when e.AltKey: if (Active is { } w) Close(w); break;
            case "q" or "Q" when e.AltKey: Quit(); break;
        }
    }

    // A maximized window drops its position so the CSS can make it fill the desktop.
    private static string GetWindowStyle(TgWindow w) => w.State == WindowState.Maximized
        ? FormattableString.Invariant($"z-index: {w.ZOrder}; --dos-box-close: #55ff55;")
        : FormattableString.Invariant($"left: {w.Left}px; top: {w.Top}px; z-index: {w.ZOrder}; --dos-box-close: #55ff55;");

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
    }
}
