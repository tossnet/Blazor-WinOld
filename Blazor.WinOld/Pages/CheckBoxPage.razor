@page "/checkbox-page"

<PageTitle>CheckBox</PageTitle>

<h1>CheckBox</h1>

<div style="display:flex; flex-direction: row; gap: 20px; flex-wrap: wrap;">
	<div style="flex:0 0 calc(25% - 20px);">
        <h7>DOS</h7>
        <div style="display:flex; flex-direction:column; width:fit-content; margin-bottom:10px; padding:4px; background:var(--dos-background);">
	<WinOldCheckBox Appearance="Appearance.DOS"
					Label="Check box"
					HotKey="C"
					Checked="true" />

	<WinOldCheckBox Appearance="Appearance.DOS"
					Label="check box"
					HotKey="b" />

	<WinOldCheckBox Appearance="Appearance.DOS"
					Label="check box"
					Disabled />

	<WinOldCheckBox Appearance="Appearance.DOS"
					Label="check box"
					Checked="true"
					Disabled />
		</div>
    </div>

    <div style="flex:0 0 calc(25% - 20px);">
        <h7>Windows 3.1</h7>
        <div style="display:flex; flex-direction:column; width:fit-content; margin-bottom:10px; padding:4px; background:white;">
			<WinOldCheckBox Checked="checkbox1"
				Appearance="Appearance.Win31"
				Label="check box"
				CheckedChanged="@CheckedChanged" />

<WinOldCheckBox Appearance="Appearance.Win31"
				Label="check box" />

<WinOldCheckBox Appearance="Appearance.Win31"
				Label="check box"
				Disabled />

<WinOldCheckBox Appearance="Appearance.Win31"
				Label="check box"
				Checked="true"
				Disabled />
		</div>
    </div>

    <div style="flex:0 0 calc(25% - 20px);">
        <h7>Windows 98</h7>
        <div style="display:flex; flex-direction:column; width:fit-content; margin-bottom:10px; padding:4px; ">
			<WinOldCheckBox Checked="checkbox1"
				Appearance="Appearance.Win98"
				Label="check box"
				CheckedChanged="@CheckedChanged" />

<WinOldCheckBox Appearance="Appearance.Win98"
				Label="check box" />

<WinOldCheckBox Appearance="Appearance.Win98"
				Label="check box"
				Disabled />

<WinOldCheckBox Appearance="Appearance.Win98"
				Label="check box"
				Checked="true"
				Disabled />
		</div
    </div>

    <div style="flex:0 0 calc(25% - 20px);">
        <h7>Windows XP</h7>
        <div style="display:flex; flex-direction:column; width:fit-content; margin-bottom:10px; padding:4px; ">
			<WinOldCheckBox Checked="true"
				Appearance="Appearance.WinXP"
				Label="check box" />

<WinOldCheckBox Appearance="Appearance.WinXP"
				Label="check box" />

<WinOldCheckBox Appearance="Appearance.WinXP"
				Label="check box"
				Disabled />
				
<WinOldCheckBox Appearance="Appearance.WinXP"
				Label="check box"
				Checked="true"
				Disabled />
		</div>
    </div>

    <div style="flex:0 0 calc(25% - 20px);">
        <h7>Windows 7</h7>
        <div style="display:flex; flex-direction:column; width:fit-content; margin-bottom:10px; padding:4px; ">
			<WinOldCheckBox Checked="checkbox1"
				Appearance="Appearance.Win7"
				Label="check box" />

<WinOldCheckBox Appearance="Appearance.Win7"
				Label="check box" />

<WinOldCheckBox Appearance="Appearance.Win7"
				Label="check box"
				Disabled />
				
<WinOldCheckBox Appearance="Appearance.Win7"
				Label="check box"
				Checked="true"
				Disabled />
		</div>
    </div>

    <div style="flex:0 0 calc(25% - 20px);">
        <h7>Windows 10</h7>
        <div style="display:flex; flex-direction:column; width:fit-content; margin-bottom:10px; padding:4px; ">
			<WinOldCheckBox Checked="checkbox1"
				Appearance="Appearance.Win10"
				Label="check box" />

<WinOldCheckBox Appearance="Appearance.Win10"
				Label="check box" />

<WinOldCheckBox Appearance="Appearance.Win10"
				Label="check box"
				Disabled />
				
<WinOldCheckBox Appearance="Appearance.Win10"
				Label="check box"
				Checked="true"
				Disabled />
		</div>
    </div>
</div>




<CodeBlock Language="CodeLanguage.Razor"
		   EnableLineNumbers="true"
		   Code=@(@"
		   	 	 <WinOldCheckBox Appearance=""Appearance.Win98""
		        	 	 Label=""check box""
		   	    	 	 @bind-Value=""checkbox1"" />
			   	 	 <WinOldCheckBox Appearance=""Appearance.DOS""
			   	 	 Label=""Copy""
			   	 	 HotKey=""C""
			   	 	 @bind-Value=""checkbox1"" />
		   	 	 <WinOldCheckBox Checked=""checkbox1""
		   	 	 Appearance=""Appearance.Win98""
		   	 	 Label=""check box""
		   	 	 CheckedChanged=""@CheckedChanged"" />
		   	 	 ") />

<CodeBlock Language="CodeLanguage.CSharp"
		   EnableLineNumbers="true"
		   Code=@(@"
		   	 	 private bool checkbox1 = true;
		   	 	 private void CheckedChanged(bool value)
		   	 	 {
		   	 	 Console.WriteLine($""Checkbox changed {value}"");
		   	 	 }
		   	 	 	 ") />

@code {
	private bool checkbox1 = true;

	private void CheckedChanged(bool value)
	{
		Console.WriteLine($"Checkbox changed {value}");
	}
}
