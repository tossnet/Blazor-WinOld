@page "/label-page"

<PageTitle>Label</PageTitle>

<h1>Label</h1>

<div style="display:flex; flex-direction:column; width:fit-content; margin-bottom:10px; padding:8px; background:var(--dos-background);">
	<WinOldLabel Appearance="Appearance.DOS">
		Hello DOS!
	</WinOldLabel>

	<WinOldLabel Appearance="Appearance.DOS" Disabled>
		Disabled DOS label
	</WinOldLabel>
</div>

<div style="display:flex; flex-direction: row; gap: 10px;">
	<WinOldLabel Appearance="Appearance.Win98">
		Hello Win98!
	</WinOldLabel>

	<WinOldLabel Appearance="Appearance.WinXP">
		Hello WinXP!
	</WinOldLabel>

	<WinOldLabel Appearance="Appearance.Win7">
		Hello Win7!
	</WinOldLabel>

	<WinOldLabel Appearance="Appearance.Win10">
		Hello Win10!
	</WinOldLabel>
</div>

<h2>Touch Mode</h2>

<div style="display:flex; flex-direction:column; width:fit-content; margin-bottom:10px; padding:8px; background:var(--dos-background);">
	<WinOldLabel Appearance="Appearance.DOS" TouchMode="true">
		Hello DOS!
	</WinOldLabel>

	<WinOldLabel Appearance="Appearance.DOS" TouchMode="true" Disabled>
		Disabled DOS label
	</WinOldLabel>
</div>

<div style="display:flex; flex-direction: row; gap: 10px;">
	<WinOldLabel Appearance="Appearance.Win98" TouchMode="true">
		Hello Win98!
	</WinOldLabel>

	<WinOldLabel Appearance="Appearance.WinXP" TouchMode="true">
		Hello WinXP!
	</WinOldLabel>

	<WinOldLabel Appearance="Appearance.Win7" TouchMode="true">
		Hello Win7!
	</WinOldLabel>

	<WinOldLabel Appearance="Appearance.Win10" TouchMode="true">
		Hello Win10!
	</WinOldLabel>
</div>

<CodeBlock Language="CodeLanguage.Razor"
		   EnableLineNumbers="true"
		   Code=@(@"
<WinOldLabel Appearance=""Appearance.Win98"">
	Hello Win98!
</WinOldLabel>

<WinOldLabel Appearance=""Appearance.DOS"">
	Hello DOS!
</WinOldLabel>

<WinOldLabel Appearance=""Appearance.DOS"" Disabled>
	Disabled DOS label
</WinOldLabel>
		   	 	 	 	 	 ") />