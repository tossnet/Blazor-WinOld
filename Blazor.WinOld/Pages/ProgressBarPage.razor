    <WinOldProgressBar Appearance="Appearance.Win31"
                       Indeterminate="true" />
  </div>

  <div class="style-col">
    <h7>Win98</h7>
    <WinOldProgressBar Appearance="Appearance.Win98"
                       Indeterminate="true" />
  </div>

  <div class="style-col">
    <h7>Win98 (blocks)</h7>
    <WinOldProgressBar Appearance="Appearance.Win98"
                       BarStyle="ProgressBarStyle.Blocks"
                       Indeterminate="true" />
  </div>

  <div class="style-col">
    <h7>WinXP</h7>
    <WinOldProgressBar Appearance="Appearance.WinXP"
                       Indeterminate="true" />
  </div>

  <div class="style-col">
