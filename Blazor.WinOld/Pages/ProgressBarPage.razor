@page "/progressbar-page"

<PageTitle>ProgressBar</PageTitle>

<h1>ProgressBar</h1>

<h2>Examples by Style</h2>

<div style="display:flex; flex-direction: row; gap: 20px; flex-wrap: wrap;">
  <div class="style-col">
    <h7>DOS</h7>
    <WinOldProgressBar Appearance="Appearance.DOS"
                       Max="100"
                       Value="70" />
  </div>

  <div class="style-col">
    <h7>Win31</h7>
    <WinOldProgressBar Appearance="Appearance.Win31"
                       Max="100"
                       Value="70" />
  </div>

  <div class="style-col">
    <h7>Win98</h7>
    <WinOldProgressBar Appearance="Appearance.Win98"
                       Max="100"
                       Value="70" />
  </div>

  <div class="style-col">
    <h7>WinXP</h7>
    <WinOldProgressBar Appearance="Appearance.WinXP"
                       Max="100"
                       Value="70" />
  </div>

  <div class="style-col">
    <h7>Win7</h7>
    <WinOldProgressBar Appearance="Appearance.Win7"
                       Max="100"
                       Value="70" />
  </div>

  <div class="style-col">
    <h7>Win10</h7>
    <WinOldProgressBar Appearance="Appearance.Win10"
                       Max="100"
                       Value="70" />
  </div>

</div>

<div style="display:flex; flex-direction: row; gap: 20px; flex-wrap: wrap;">
